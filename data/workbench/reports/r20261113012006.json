 "conflicts": [
  {
   "concepts": [
    "c1"
   ],
   "kind": "sailing",
   "name": "Close-hauled",
   "sources": [
    "m-auth-method",
    "m-ref-veleiro"
   ],
   "text": "Veleiro.net (pt-BR) uses both 'Orça Fechada' and 'orça' for close-hauled sailing.",
   "type": "term"
  },
  {
   "concepts": [
    "c7"
   ],
   "kind": "sailing",
   "name": "Reefing",
   "sources": [
    "m-auth-method",
    "m-ref-veleiro"
   ],
   "text": "Method doc includes replacing the sail with a storm sail. Veleiro.net 'Rizar' covers folding the mainsail and rolling the genoa. 'rizo' covers reducing the mainsail only.",
   "type": "definition"
  },
  {
   "concepts": [
    "c10"
   ],
   "kind": "hull",
   "name": "Gaff rig",
   "sources": [
    "m-auth-method",
    "m-hist-getlisbon"
   ],
   "text": "c10 describes the gaff rig used together with a jib; the candidate says the fragata flies its gaff sail with one or two headsails. This is a minor difference in the number of headsails, not a clear contradiction.",
   "type": "number"
  },
  {
   "concepts": [
    "c18"
   ],
   "kind": "hull",
   "name": "Leeboard",
   "sources": [
    "m-auth-method",
    "m-hist-pedrosa"
   ],
   "text": "Existing concept describes a board lowered to reduce slip in shallow water. The candidate (tábua de bolina) describes a lateral keel on one side, one per side on the muleta, for lateen-rigged flat-bottomed boats; it also adds dates (documented 1710, on other boats 1785) not in the existing concept. Possibly complementary rather than conflicting.",
   "type": "definition"
  },
  {
   "concepts": [
    "c19"
   ],
   "kind": "sailing",
   "name": "Approach and docking",
   "sources": [
    "m-auth-method",
    "m-hist-blk-portos",
    "mmwdz14kpqwcc"
   ],
   "text": "Method doc describes the skill of controlling speed to come alongside. Fragateiro defines it as a mission phase triggered within a set distance of the target.",
   "type": "definition"
  },
  {
   "concepts": [
    "c23"
   ],
   "kind": "sailing",
   "name": "Sail trim",
   "sources": [
    "m-auth-method",
    "m-ref-veleiro"
   ],
   "text": "Veleiro.net (pt-BR) uses both 'Ajuste das Velas' and 'mareação' for sail trim.",
   "type": "term"
  },
  {
   "concepts": [
    "c25"
   ],
   "kind": "sailing",
   "name": "Gust",
   "sources": [
    "m-auth-method"
   ],
   "text": "Method doc defines a gust as a sudden increase in wind. Fragateiro's gust_or_shift also includes changes in wind direction.",
   "type": "definition"
  },
  {
   "concepts": [
    "c42"
   ],
   "kind": "hull",
   "name": "Forestay",
   "sources": [
    "m-ref-veleiro",
    "mmwdz14kpqwcc"
   ],
   "text": "Existing 'Forestay' is a wire from bow to masthead; the candidate 'estai' is a generic stay set with the varino's lateen sail. Similar, but the source does not say it runs from the bow.",
   "type": "definition"
  },
  {
   "concepts": [
    "c67"
   ],
   "kind": "sailing",
   "name": "Luffing (sail flapping)",
   "sources": [
    "m-ref-veleiro"
   ],
   "text": "Fragateiro web game (en) uses 'sail_luffing', 'luffing' and 'flaps' for a sail flapping unfilled.",
   "type": "term"
  },
  {
   "concepts": [
    "c89"
   ],
   "kind": "sailing",
   "name": "Wind shift",
   "sources": [
    "m-ref-veleiro"
   ],
   "text": "Veleiro.net 'rondada' describes only a shift away from the bow. 'rondada de vento' and fragateiro wind_shift describe any change in wind direction.",
   "type": "definition"
  }
 ],
